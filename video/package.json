{
  "name": "gradient-film",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.tsx --port=3200",
    "capture": "node scripts/capture.mjs",
    "audio": "node scripts/elevenlabs.mjs",
    "typecheck": "tsc --noEmit",
    "render": "node scripts/render.mjs",
    "render:captioned": "node scripts/caption.mjs",
    "thumbnail": "remotion still src/index.tsx GradientThumbnail out/gradient-thumbnail.png",
    "preview:frames": "node scripts/render.mjs --stills",
    "audio:elevenlabs": "node scripts/elevenlabs.mjs",
    "audio:voices": "node scripts/elevenlabs.mjs --voices",
    "package": "node scripts/package.mjs",
    "audio:local": "node scripts/audio.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.539",
    "@remotion/media": "4.0.539",
    "remotion": "4.0.539",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "@remotion/bundler": "4.0.539",
    "@remotion/renderer": "4.0.539"
  },
  "devDependencies": {
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "playwright": "^1.58.0",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "zod": "4.6.6"
  }
}
